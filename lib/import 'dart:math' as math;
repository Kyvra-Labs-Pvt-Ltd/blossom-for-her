    } else if (phase == CyclePhase.luteal) {
      parts.add(
        'Day $cDay sits in your luteal window where PdG ($pdg idx) dominates to support endometrial stability.',
      );
    } else if (phase == CyclePhase.menstrual) {
      parts.add(
        'Day $cDay marks early-cycle baseline reset with low E3G ($e3g idx) and PdG ($pdg idx).',
      );
    } else {
      parts.add(
        'On Day $cDay, follicular recruitment is underway as E3G ($e3g idx) steadily builds.',
      );
    }

    if (daySymptoms.isNotEmpty) {
      parts.add(
        'Your logged ${daySymptoms.join(" & ").toLowerCase()} aligns with this ${phase.shortLabel.toLowerCase()} shift.',
      );
    } else if (mood != null) {
