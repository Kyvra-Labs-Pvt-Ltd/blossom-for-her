}

class StyledField extends StatelessWidget {
  final TextEditingController controller;
  final String hint;
  final IconData icon;
  final TextInputType type;
  final bool obscure;
  final Widget? suffix;

  const StyledField({
    super.key,
    required this.controller,
    required this.hint,
    required this.icon,
    this.type = TextInputType.text,
    this.obscure = false,
    this.suffix,
  });

  @override
  Widget build(BuildContext context) => TextField(
        controller: controller,
        keyboardType: type,
        obscureText: obscure,
        style: sansStyle(color: ink, size: 14, weight: FontWeight.w600),
        decoration: InputDecoration(
          hintText: hint,
          hintStyle: sansStyle(color: stoneMuted.withAlpha(153), size: 13),
          prefixIcon: Icon(icon, color: stoneMuted, size: 20),
          suffixIcon: suffix,
          filled: true,
          fillColor: Colors.white,
          contentPadding:
              const EdgeInsets.symmetric(vertical: 17, horizontal: 16),
          border: OutlineInputBorder(
            borderRadius: BorderRadius.circular(16),
            borderSide: const BorderSide(color: borderStone),
          ),
          enabledBorder: OutlineInputBorder(
            borderRadius: BorderRadius.circular(16),
            borderSide: const BorderSide(color: borderStone),
          ),
          focusedBorder: OutlineInputBorder(
            borderRadius: BorderRadius.circular(16),
            borderSide: const BorderSide(color: terracotta, width: 1.6),
          ),
        ),
      );
}

