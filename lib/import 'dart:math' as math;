class _SimulatedTestScreenState extends State<SimulatedTestScreen>
    with SingleTickerProviderStateMixin {
  late int testDay;
  bool scanning = false;
  bool resultReady = false;
  late AnimationController _scanCtrl;

  @override
  void initState() {
    super.initState();
    testDay = widget.cycleDay.clamp(1, widget.cycleLength);
    _scanCtrl = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 1400),
    );
  }

  @override
  void dispose() {
    _scanCtrl.dispose();
    super.dispose();
  }

  Map<String, double> _currentReadings() {
    final map = <String, double>{};
    for (final h in hormoneNames) {
      final vals = simulatedHormoneValues(h, widget.cycleLength);
      map[h] = vals[(testDay - 1).clamp(0, vals.length - 1)];
    }
    return map;
  }

  Future<void> _runScan() async {
    setState(() {
      scanning = true;
      resultReady = false;
    });
    await _scanCtrl.forward(from: 0.0);
    if (!mounted) return;
    final readings = _currentReadings();
    widget.onSaveScan(testDay, readings);
    setState(() {
      scanning = false;
      resultReady = true;
    });
